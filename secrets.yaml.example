# Copy this file to secrets.yaml (ignored by git) and replace every value.
#
# The three keys api_encryption_key, web_username and web_password
# must ALSO exist in /config/esphome/secrets.yaml on Home Assistant. The firmware
# is built there from those values; without them the ESPHome dashboard stops with
# "Secret '<name>' not defined".

# 32-byte base64 key. It encrypts the native API connection to Home Assistant and
# the OTA firmware updates (ota: encryption). Generate one with:
#   py -3 -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# or with the key generator on the ESPHome page (the key is created in your browser):
#   https://esphome.io/components/api/#configuration-variables
api_encryption_key: "REPLACE_WITH_GENERATED_BASE64_KEY"

# Login for the web interface (http://astro-environmental.local)
web_username: "CHANGE_ME"
web_password: "CHANGE_ME"

# WiFi credentials (esphome-astro-environmental/network/wifi.yaml)
wifi_ssid: "CHANGE_ME"
wifi_password: "CHANGE_ME"

# Fixed IP address (only needed if you enable manual_ip in the network file)
#static_ip: "192.168.1.50"
#gateway: "192.168.1.1"
#subnet: "255.255.255.0"
